# Public Supabase project URL and anon/publishable key.
# Project URL: https://<project-ref>.supabase.co (the ref is in your browser's
# address bar after supabase.com/dashboard/project/).
# Key: the "publishable key" (sb_publishable_...) from Settings -> API Keys.
# This is the new name for the old "anon" key. Do NOT use the secret key.
# Local dev: copy this file to .env and fill in the values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
